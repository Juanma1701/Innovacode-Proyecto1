<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ══ Toolbar ══ -->
        <LinearLayout
            android:id="@+id/toolbarExportar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#161B22"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/btnVolver"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_flecha_atras"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#6C63FF"
                android:contentDescription="Volver" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Exportar Reporte"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <View android:layout_width="40dp" android:layout_height="40dp" />
        </LinearLayout>

        <!-- ══ Período ══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECCIONAR PERÍODO"
            android:textColor="#A0A8C0"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:id="@+id/layoutOpcionesPeriodo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnPeriodoHoy"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Hoy"
                android:textColor="#A0A8C0"
                android:textSize="12sp"
                android:background="@drawable/fondo_boton_outline"
                android:stateListAnimator="@null"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnPeriodoSemana"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Semana"
                android:textColor="#A0A8C0"
                android:textSize="12sp"
                android:background="@drawable/fondo_boton_outline"
                android:stateListAnimator="@null"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnPeriodoMes"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Mes"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@drawable/fondo_boton_violeta"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- ══ Card PDF ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/fondo_tarjeta"
            android:padding="20dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄"
                    android:textSize="28sp"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exportar PDF"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reporte visual con gráficas incluidas"
                        android:textColor="#A0A8C0"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Lo que incluye -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓  Balance de ventas por día"
                android:textColor="#A0A8C0"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓  Movimientos de inventario"
                android:textColor="#A0A8C0"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓  Inventario con estado de stock"
                android:textColor="#A0A8C0"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓  Lista de proveedores"
                android:textColor="#A0A8C0"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnExportarPDF"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Generar PDF"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/fondo_boton_violeta"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- ══ Card Excel ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/fondo_tarjeta"
            android:padding="20dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊"
                    android:textSize="28sp"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exportar Excel"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Datos en hojas separadas para análisis"
                        android:textColor="#A0A8C0"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓  Hoja Resumen general"
                android:textColor="#A0A8C0"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓  Hoja Ventas con totales"
                android:textColor="#A0A8C0"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓  Hoja Movimientos de inventario"
                android:textColor="#A0A8C0"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓  Hoja Inventario con estados"
                android:textColor="#A0A8C0"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓  Hoja Proveedores"
                android:textColor="#A0A8C0"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnExportarExcel"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Generar Excel"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/fondo_boton_violeta"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- ══ Estado / Progress ══ -->
        <ProgressBar
            android:id="@+id/progressExportar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"/>

        <TextView
            android:id="@+id/tvEstadoExportar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A0A8C0"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginStart="16dp"/>

    </LinearLayout>
</ScrollView>
