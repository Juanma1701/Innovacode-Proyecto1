<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    tools:context=".Dashboard.Content.Dashboard">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="24dp">

            <!-- ══════════════════════════════════════════ -->
            <!-- HEADER                                     -->
            <!-- ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:orientation="vertical"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:gravity="right">

                        <ImageButton
                            android:id="@+id/btnperfil"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:src="@drawable/ic_persona"
                            android:scaleType="fitCenter"
                            android:padding="14dp"
                            android:background="@drawable/fondo_persona_perfil"
                            app:tint="@color/white"
                            android:pointerIcon="hand"/>

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imageView2"
                        android:layout_width="80dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        app:srcCompat="@drawable/ic_logo_innovacode" />

                    <TextView
                        android:id="@+id/titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NovaCore"
                        android:textColor="#29ABE2"
                        android:textSize="30dp"
                        android:textStyle="bold"
                        android:gravity="top"/>

                </LinearLayout>
            </LinearLayout>

            <!-- ══════════════════════════════════════════ -->
            <!-- 1. ALERTAS EXPANDIDAS                      -->
            <!-- ══════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/seccionAlertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <!-- Stock mínimo -->
                <LinearLayout
                    android:id="@+id/cardAlertas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/fondo_alerta_stock"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️"
                        android:textSize="20sp"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tvResumenAlertas"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#FFCC00"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!-- Próximos a vencer -->
                <LinearLayout
                    android:id="@+id/cardAlertasVencimiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/fondo_alerta_vencimiento"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕐"
                        android:textSize="20sp"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tvResumenVencimiento"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#FF8C42"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!-- Ventas inusuales -->
                <LinearLayout
                    android:id="@+id/cardAlertasVentasInusuales"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/fondo_alerta_inusual"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📈"
                        android:textSize="20sp"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tvResumenVentasInusuales"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#C084FC"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ══════════════════════════════════════════ -->
            <!-- 2. BOTONES DE MÓDULOS                      -->
            <!-- ══════════════════════════════════════════ -->

            <!-- Fila 1: Inventario + Reportes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/btninvent"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_margin="10dp"
                    android:text="Inventario"
                    android:background="@drawable/boton_personalizado"
                    android:drawableTop="@drawable/ic_inventario"
                    android:drawablePadding="8dp"
                    android:paddingTop="20dp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16dp"
                    android:pointerIcon="hand"/>

                <Button
                    android:id="@+id/btnreportes"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_margin="10dp"
                    android:drawableTop="@drawable/ic_reportes"
                    android:background="@drawable/boton_personalizado"
                    android:paddingTop="20dp"
                    android:text="Reportes"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:pointerIcon="hand"/>
            </LinearLayout>

            <!-- Fila 2: Compras + Ventas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/btncompras"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_margin="10dp"
                    android:drawableTop="@drawable/ic_compras"
                    android:background="@drawable/boton_personalizado"
                    android:paddingTop="20dp"
                    android:text="Compras"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:pointerIcon="hand"/>

                <Button
                    android:id="@+id/btnventas"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_margin="10dp"
                    android:drawableTop="@drawable/ic_ventas"
                    android:background="@drawable/boton_personalizado"
                    android:paddingTop="20dp"
                    android:text="Ventas"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:pointerIcon="hand"/>
            </LinearLayout>

            <!-- Fila 3: Proveedores + Recetas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btnproveedores"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_margin="10dp"
                    android:drawableTop="@drawable/ic_proveedores"
                    android:background="@drawable/boton_personalizado"
                    android:paddingTop="20dp"
                    android:text="Proveedores"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:pointerIcon="hand"/>

                <Button
                    android:id="@+id/btnrecetas"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_margin="10dp"
                    android:drawableTop="@drawable/ic_recetas"
                    android:background="@drawable/boton_personalizado"
                    android:paddingTop="20dp"
                    android:text="Recetas"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:pointerIcon="hand"/>

            </LinearLayout>

            <!-- ══════════════════════════════════════════ -->
            <!-- 3. KPIs — grid 2×2                         -->
            <!-- ══════════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resumen del mes"
                android:textColor="#A0A8C0"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"/>

            <!-- Fila KPI 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="8dp">

                <!-- Margen -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/fondo_tarjeta">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 Margen"
                        android:textColor="#A0A8C0"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/tvKpiMargen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#4ADE80"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ganancia neta"
                        android:textColor="#6B7280"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <!-- Proyección -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/fondo_tarjeta">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔮 Proyección"
                        android:textColor="#A0A8C0"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/tvKpiProyeccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#29ABE2"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="al cierre del mes"
                        android:textColor="#6B7280"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Fila KPI 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="16dp">

                <!-- Top producto -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/fondo_tarjeta">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏆 Top producto"
                        android:textColor="#A0A8C0"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/tvKpiTopProducto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:maxLines="2"
                        android:ellipsize="end"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="más vendido del mes"
                        android:textColor="#6B7280"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <!-- Mejor día -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/fondo_tarjeta">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 Mejor día"
                        android:textColor="#A0A8C0"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/tvKpiMejorDia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#F59E0B"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="más rentable"
                        android:textColor="#6B7280"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ══════════════════════════════════════════ -->
            <!-- 4. META MENSUAL                            -->
            <!-- ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="20dp"
                android:padding="16dp"
                android:background="@drawable/fondo_tarjeta">

                <!-- Encabezado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎯  Meta mensual de ventas"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <ImageButton
                        android:id="@+id/btnEditarMeta"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_editar"
                        android:scaleType="fitCenter"
                        android:padding="6dp"
                        android:background="@drawable/fondo_boton_outline"
                        app:tint="#6C63FF"
                        android:contentDescription="Editar meta"
                        android:pointerIcon="hand"/>

                </LinearLayout>

                <!-- Montos actual / objetivo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Actual"
                            android:textColor="#A0A8C0"
                            android:textSize="11sp"/>

                        <TextView
                            android:id="@+id/tvMetaActual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0"
                            android:textColor="#4ADE80"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Meta"
                            android:textColor="#A0A8C0"
                            android:textSize="11sp"/>

                        <TextView
                            android:id="@+id/tvMetaObjetivo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0"
                            android:textColor="#A0A8C0"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- ProgressBar -->
                <ProgressBar
                    android:id="@+id/progressMeta"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_meta"
                    android:layout_marginBottom="8dp"/>

                <!-- Porcentaje y faltante -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMetaPorcentaje"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0%"
                        android:textColor="#6C63FF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvMetaFaltante"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Faltan $0"
                        android:textColor="#6B7280"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>