<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/fondo_tarjeta"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical">

    <!-- Ícono inicial del nombre -->
    <TextView
        android:id="@+id/tvInicialProveedor"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/fondo_tarjeta_perfil"
        android:layout_marginEnd="14dp"
        android:text="P"/>

    <!-- Info del proveedor -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreProveedor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre proveedor"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvNitProveedor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NIT: —"
            android:textColor="#9B7FD4"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvContactoProveedor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📞 Sin contacto"
            android:textColor="#B0B0CC"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvEmailProveedor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✉️ Sin email"
            android:textColor="#B0B0CC"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Botones de acción -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnEditarProveedor"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/fondo_boton_violeta"
            android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="Editar"
            android:padding="6dp"
            android:layout_marginBottom="6dp"/>

        <ImageButton
            android:id="@+id/btnEliminarProveedor"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/fondo_tarjeta"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Eliminar"
            android:padding="6dp"
            app:tint="#FF6B6B"/>
    </LinearLayout>

</LinearLayout>
