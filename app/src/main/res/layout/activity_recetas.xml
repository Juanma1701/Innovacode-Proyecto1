<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- ══ Toolbar ══ -->
    <LinearLayout
        android:id="@+id/toolbarRecetas"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#111827"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_flecha_atras"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#6C63FF"
            android:contentDescription="Volver" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recetas"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/btnAgregarReceta"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ Nueva"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/fondo_boton_violeta"
            android:stateListAnimator="@null"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <!-- ══ Búsqueda ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="@drawable/fondo_campo_dark"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_margin="16dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_buscar"
            app:tint="#6B7280"
            android:contentDescription="Buscar"
            android:layout_marginEnd="10dp" />

        <EditText
            android:id="@+id/etBuscarReceta"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Buscar receta..."
            android:textColorHint="#3D3D5C"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@null"
            android:singleLine="true"
            android:inputType="text" />
    </LinearLayout>

    <!-- ══ Lista de recetas ══ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRecetas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

</LinearLayout>
